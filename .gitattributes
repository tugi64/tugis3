* text=auto eol=lf

# Treat Kotlin/Gradle files as text, enforce LF
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Mark common binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.keystore binary
*.jks binary
*.jar binary
*.zip binary
*.kmz binary
*.kml binary
*.pdf binary
*.apk binary
*.aab binary
*.docx binary

