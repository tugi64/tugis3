<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kalite Limitleri"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HRMS Limit:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHrmsLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.05 m"
                android:textAlignment="textEnd" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VRMS Limit:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVrmsLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.08 m"
                android:textAlignment="textEnd" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PDOP Limit:"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPdopLimit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="18.0"
                android:textAlignment="textEnd" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC"
            android:layout_marginVertical="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Genel Ayarlar"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Switch
            android:id="@+id/switchSameOperation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aynı İşlem"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switchFocusLastPoint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Son Noktaya Odaklan"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnDefaultConfigurations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Varsayılan Konfigürasyonlar"
            android:backgroundTint="#FF9800"
            android:textColor="@android:color/white" />

    </LinearLayout>

</ScrollView>
