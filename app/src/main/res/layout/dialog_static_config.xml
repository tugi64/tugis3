<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Statik Nokta Adı"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etStaticName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Statik nokta adı girin"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PDOP Limit"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPdopLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="18.0"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yükseklik Açısı (°)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etElevationAngle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="10"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Toplama Aralığı"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgCollectionInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb60s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="60 Saniye" />

            <RadioButton
                android:id="@+id/rb30s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 Saniye" />

            <RadioButton
                android:id="@+id/rb15s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 Saniye" />

            <RadioButton
                android:id="@+id/rb10s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 Saniye" />

            <RadioButton
                android:id="@+id/rb5s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Saniye" />

            <RadioButton
                android:id="@+id/rb2s"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Saniye" />

            <RadioButton
                android:id="@+id/rb1hz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 Hz"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb2hz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 Hz" />

            <RadioButton
                android:id="@+id/rb5hz"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 Hz" />

        </RadioGroup>

        <Switch
            android:id="@+id/switchStaticAutoRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Otomatik Kayıt"
            android:checked="true" />

    </LinearLayout>

</ScrollView>
