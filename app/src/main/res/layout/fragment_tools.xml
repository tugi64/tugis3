<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar_tools"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Araçlar"
            app:titleTextColor="@android:color/white"
            app:navigationIcon="@drawable/ic_arrow_back" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Lokalizasyon -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_localization"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Lokalizasyon"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_localization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Koordinat Dönüştürücü -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_coord_converter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Koordinat Dönüştürücü"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_coord_converter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Açı Dönüştürücü -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_angle_converter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Açı Dönüştürücü"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_angle_converter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Çevre ve Alan Hesaplama -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_area_calculation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Çevre ve Alan"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_area_calculation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- COGO Hesaplama -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_cogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="COGO Hesaplama"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_cogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hesap Makinesi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_calculator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hesap Makinesi"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_calculator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Harici Radyo Yapılandırma -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_external_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Harici Radyo Yapılandırma"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_external_radio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hacim Hesaplama -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Hacim Hesaplama"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_volume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Grid'den Zemine -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_grid_to_ground"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Grid'den Zemine"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_grid_to_ground"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FTP Paylaşılan Veri -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ftp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FTP Paylaşılan Veri"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_ftp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aç" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

